// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model LessonProgress {
  id           Int       @id @default(autoincrement())
  courseId     String
  lessonId     String
  status       String    @default("not_started") // not_started | in_progress | completed
  currentSlide Int       @default(0)
  draftCode    String? // 中断した時点のエディタ内容。currentSlideと必ず同時に保存する
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([courseId, lessonId])
}

model StudyDay {
  id Int @id @default(autoincrement())
  // "YYYY-MM-DD"。DateTimeで持つとUTC保存になり、深夜帯に学習した日が
  // SQL集計で前日に寄ってしまうため、確定済みの日付を文字列で保存する
  date           String  @unique
  studySeconds   Int     @default(0)
  solvedExercise Boolean @default(false) // その日1問でも正解したか（ストリーク判定用）
}

model CourseProgress {
  id               Int      @id @default(autoincrement())
  courseId         String   @unique
  totalLessons     Int
  completedLessons Int      @default(0)
  updatedAt        DateTime @updatedAt
}
