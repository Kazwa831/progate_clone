DATABASE_URL="file:../data/app.db"

# ---- 認証（Better Auth） ----
# セッション署名用の秘密鍵。次のコマンドで生成した値を貼り付けてください:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# アプリのベースURL。ローカル開発ではこのままで動きます
BETTER_AUTH_URL="http://localhost:3000"

# ---- Google OAuth（段階4で使用。それまでは空のままで構いません） ----
# Google Cloud Console > APIとサービス > 認証情報 で発行した値
#   承認済みのリダイレクトURI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
